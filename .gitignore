# Local-only — never commit
.env
*.duckdb
*.db
*.bak
__pycache__/
*.pyc
.venv/
*.code-workspace
scripts/probe_industry_endpoint_result.json
scripts/rule_mining_input.json
scripts/no_match_clusters_pass2.json
SET_ALL_API/
sample news/
.claude/

# Regulation source PDFs for the Lex agent — uploaded to the Gemini File Search
# store, not tracked in git. data/regulations-index.json (the manifest) IS tracked.
regulations/
regulations-test/

# Wrangler local state — never commit
.wrangler/
.dev.vars
.dev.vars.*

# In-session synthesis scratch — never commit
# context/ is regenerable byte-for-byte by dump_contexts.py; out/ is already
# merged into data/company-reports.json, so the source-of-truth is tracked there.
data/synthesis/

# Playwright MCP scratch (browser snapshots/console logs from headless runs)
.playwright-mcp/

# Daily brief test fixtures — small ones (ai_insights, morning_brief,
# tickers, dry_run_payload) are committed for fast offline tests.
# disclosure_pulse.json is gitignored (2.1 MB, 1961 filings) — tests
# fall back to a synthetic empty pulse if missing.
tests/fixtures/disclosure_pulse_*.json

# Build artifacts that ARE committed (do not ignore):
# data/*.json — these are the daily snapshots that drive the dashboards
