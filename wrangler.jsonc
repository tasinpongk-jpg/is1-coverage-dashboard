{
  // Cloudflare Workers deploy for the IS1 coverage dashboard.
  // Static assets (*.html + data/*.json) plus one server route:
  // POST /api/chat — Workers AI chatbot grounded in the daily snapshots
  // (token-gated via the CHAT_TOKEN worker secret, synced from the
  // GitHub Actions secret of the same name on every daily deploy).
  // Keeps the existing *.workers.dev URL stable across deploys.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "is1-coverage-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-05-08",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  // Durable store for agent 👍/👎 feedback (POST /api/feedback in worker.js).
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "13d03f42d4344003b256c3fceceaf116" }
  ]
}
